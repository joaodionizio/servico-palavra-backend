DATABASE_PROVIDER=sqlite
ConnectionStrings__DefaultConnection=Data Source=servico-palavra-dev.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
INITIAL_ADMIN_EMAIL=admin@example.local
INITIAL_ADMIN_PASSWORD=replace-with-one-time-bootstrap-password
INITIAL_ADMIN_NAME=Admin Local

# Password recovery / email
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=smtp.example.local
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-secret
SMTP_FROM_ADDRESS=no-reply@example.local
SMTP_FROM_NAME=Servico da Palavra
SMTP_ENABLE_SSL=true
